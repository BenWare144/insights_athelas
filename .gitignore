# Ignore everything by default: this folder accumulates .mhtml page captures
# and console logs that contain real patient names (PHI). Only explicitly
# whitelisted files may enter git.
*

# --- whitelisted ---
!.gitignore
!AGENTS.md
!CLAUDE.md
!HANDOFF.md
!DECISIONS.md
!CHANGELOG.md
!DEPLOYMENT.md
!package.json

!athelas-insights-helper-extension/
!athelas-insights-helper-extension/**

# source-of-truth Tampermonkey userscript
!userscript/
!userscript/**

!tests/
!tests/**

# live matching engine (canonical) + its decision docs + research trail
!matching/
!matching/**

# source/reference data behind the rules (exercise lists, canonical xlsx) - not PHI
!reference/
!reference/**

# canonical survey-scoring engine (functional-outcome features) + its tests
!surveys/
!surveys/**

# dev helper scripts (e.g. build-local.js)
!scripts/
!scripts/**

# Web Store deploy assets (the *.zip build artifact stays ignored via *.zip below)
!deploy/
!deploy/**

# historical / parked code, kept so nothing is lost (compact-mode redesign,
# the feature-toggle idea, the original v1 prompt)
!archive/
!archive/**

# never these, even inside whitelisted dirs
node_modules/
*.log
*.mhtml
*.zip
*.new
*.tmp
*.local.user.js

# PHI captures live here (console logs, .mhtml page saves, chart-note DOM dumps).
# Redundantly ignored as a whole folder in addition to the *.log/*.mhtml rules
# above - a belt-and-suspenders guard so real patient data can never be committed.
captures/
captures/**
